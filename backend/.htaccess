# Racine web du sous-domaine sungku.trugroup.cm.
#
# Le compte FTP est cloisonné sur ce répertoire : le code applicatif ne peut
# pas être placé au-dessus. La protection repose donc entièrement sur ces
# règles et sur les .htaccess des sous-dossiers.

RewriteEngine On

# Forcer HTTPS : les cookies de session et les callbacks pawaPay n'ont rien à
# faire en clair.
#
# DÉSACTIVÉ TANT QU'AUTOSSL N'EST PAS ACTIF sur sungku.trugroup.cm. Le domaine
# ne répond pas encore en HTTPS : cette redirection enverrait chaque requête
# vers une URL morte, y compris la sonde /health. Décommenter les deux lignes
# dès que le certificat est délivré — et le faire avant d'ouvrir le service au
# public, une session transportée en clair est rejouable.
#
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Refuser toute URL menant aux dossiers de code, quelle que soit la casse.
# Les .htaccess qui s'y trouvent font déjà ce travail ; celui-ci les double au
# cas où AllowOverride serait un jour restreint sur ce compte.
RewriteRule ^(?i)(app|bin|database|storage)(/|$) - [F,L]

# Tout le reste vers le front controller, sauf les fichiers réellement
# présents (assets).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# L'en-tête Authorization est absorbé par certaines configurations CGI :
# sans cette ligne, aucune authentification par en-tête ne remonte à PHP.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Le .env porte le token pawaPay et les accès base : il partage le dossier
# servi par Apache, il ne doit jamais en sortir.
#
# Les deux syntaxes de contrôle d'accès coexistent ici. « Require » est celle
# d'Apache 2.4 ; sur un serveur 2.2, ou si mod_authz_core n'est pas chargé,
# elle provoque une erreur 500 sur TOUTES les requêtes du dossier — un refus
# d'accès mal orthographié coupe le site entier, pas seulement la règle.
<FilesMatch "^\.env|^\.gitignore$|\.log$|\.sql$|\.md$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Pas de « Options -Indexes » : la directive Options est refusée quand
# AllowOverride ne l'autorise pas, ce qui suffit à casser tout le site. Le
# listage de dossier est de toute façon impossible — la réécriture envoie
# chaque URL sans fichier correspondant vers index.php.
