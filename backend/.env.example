# Copier en .env À LA RACINE APPLICATIVE (/home/trugro9159/sungku/.env),
# jamais dans public_html et jamais dans le dépôt Git.

APP_ENV="production"          # "local" pour afficher les erreurs
APP_URL="https://sungku.trugroup.cm"

# Base de données (cPanel → Bases de données MySQL)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# pawaPay — https://docs.pawapay.io/v2
# Bac à sable : https://api.sandbox.pawapay.io
# Production  : https://api.pawapay.io   ← argent réel
PAWAPAY_BASE_URL="https://api.sandbox.pawapay.io"
PAWAPAY_API_TOKEN=""
PAWAPAY_CURRENCY="XAF"

# Bornes de montant appliquées avant même d'appeler pawaPay.
PAYMENT_MIN_AMOUNT="100"
PAYMENT_MAX_AMOUNT="1000000"

# Rapprochement (bin/reconcile.php, lancé par cron)
# Délai avant d'aller vérifier une contribution en attente.
RECONCILE_AFTER_MINUTES="15"
# Au-delà, la contribution passe en NEEDS_ATTENTION pour vérification humaine.
# Jamais en FAILED : l'argent a peut-être bougé.
ABANDON_AFTER_HOURS="24"

# Messagerie transactionnelle (reçus, alertes organisateur).
# Compte authentifié plutôt que mail() : sur mutualisé, mail() part sans
# authentification et finit en indésirable — inacceptable pour un reçu.
MAIL_HOST="mx-dc03.ewodi.net"
MAIL_PORT="587"
MAIL_ENCRYPTION="tls"        # "tls" (587, STARTTLS) ou "ssl" (465)
MAIL_USER="noreply@trugroup.cm"
MAIL_PASSWORD=""
MAIL_FROM="noreply@trugroup.cm"
MAIL_FROM_NAME="Sungku"

# Destinataire des alertes d'exploitation (transactions à trancher à la main).
ADMIN_ALERT_EMAIL=""

# Origines navigateur autorisées (liste blanche, séparées par des virgules).
CORS_ORIGINS="https://sungku.trugroup.cm,http://localhost:3000"
