# Toutes les requêtes vers le front controller, sauf les fichiers réellement
# présents (assets). Sans cela, chaque URL de l'API devrait exister comme
# fichier sur le disque.
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# L'en-tête Authorization est absorbé par certaines configurations CGI :
# sans cette ligne, aucune authentification par en-tête ne remonte à PHP.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Forcer HTTPS : les callbacks pawaPay et les cookies de session n'ont rien à
# faire en clair.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Ceinture et bretelles : ces fichiers ne devraient pas se trouver ici, mais
# s'ils y atterrissent un jour, ils ne seront pas servis.
<FilesMatch "^\.env|\.log$|\.sql$|composer\.(json|lock)$">
    Require all denied
</FilesMatch>

Options -Indexes
