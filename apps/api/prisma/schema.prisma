generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; debian target for the node:20-slim deploy image (Railway/Docker).
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Category: SANTE | FUNERAILLES | PROJET_COMMUNAUTAIRE | EDUCATION | ENTREPRISE | TONTINE
// Visibility: PUBLIQUE | PRIVEE
// ContributionStatus: PENDING | CONFIRMED | FAILED
// PaymentChannel: ORANGE_MONEY | MTN_MOMO | NFC | QR | CARTE
// SQLite has no native enum support in Prisma, so these are plain strings validated at the API layer.

model Campaign {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  description   String
  category      String
  targetAmount  Int
  deadline      DateTime?
  coverImage    String?
  beneficiary   String
  visibility    String   @default("PUBLIQUE")
  isTontine     Boolean  @default(false)
  qrCodeDataUrl String?
  organizerId   String?
  organizer     User?    @relation(fields: [organizerId], references: [id])
  // moderationStatus: APPROVED | PENDING | REJECTED (sensitive categories start PENDING)
  moderationStatus String @default("APPROVED")
  createdAt     DateTime @default(now())
  contributions Contribution[]
  reports       Report[]
}

// Organizer account (role 3)
// kycStatus: NONE | LIGHT | PENDING_DOC | VERIFIED
model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  phone          String?
  emailVerified  Boolean    @default(false)
  kycStatus      String     @default("NONE")
  kycIdNumber    String?
  withdrawMethod String?    // wallet | mobile_money
  withdrawPhone  String?
  isAdmin        Boolean    @default(false)
  createdAt      DateTime   @default(now())
  campaigns      Campaign[]
}

// User report on a campaign (moderation queue)
// status: OPEN | RESOLVED | DISMISSED
model Report {
  id            String   @id @default(uuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id])
  reason        String
  reporterEmail String?
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
}

// Global platform settings (e.g. fees per category), stored as key -> JSON value
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Short-lived email OTP codes
// purpose: register_verify | login | withdraw
model OtpToken {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  purpose   String
  meta      String?  // e.g. withdraw amount/destination as JSON
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Partner / third-party developer account (role 4)
// status: PENDING | APPROVED | REJECTED
model Partner {
  id           String   @id @default(uuid())
  orgName      String
  contactName  String
  contactEmail String   @unique
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  apiKeys      ApiKey[]
}

// env: sandbox | production ; scopes: csv of read|campaigns:create|contributions:create|withdraw
model ApiKey {
  id         String   @id @default(uuid())
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id])
  env        String
  keyId      String   @unique
  secretHash String
  scopes     String
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Contribution {
  id              String   @id @default(uuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id])
  amount          Int
  channel         String
  status          String   @default("PENDING")
  contributorName String?
  isAnonymous     Boolean  @default(false)
  message         String?
  phoneNumber     String?
  providerTxId    String?  // Camoo cashOut.id
  createdAt       DateTime @default(now())
}
