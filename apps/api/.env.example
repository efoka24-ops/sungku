DATABASE_URL="postgresql://user:password@host:5432/dbname"
PORT=4000

# Public base URL of this API (used to build the Camoo notification_url webhook)
APP_PUBLIC_URL="http://localhost:4000"

# Camoo Payment API — https://api.camoo.cm/v1/payment
# Leave CAMOO_API_KEY / CAMOO_API_SECRET blank in local dev to use the simulated
# confirmation fallback instead of calling the real payment provider.
CAMOO_BASE_URL="https://api.camoo.cm/v1/payment"
CAMOO_API_KEY=""
CAMOO_API_SECRET=""
CAMOO_CURRENCY="XAF"

# Auth / JWT
JWT_SECRET="change-me"
OTP_TTL_MINUTES="10"

# SMTP (email OTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NoReply Sungku <noreply@example.com>"

# SMS provider — "stub" (log only) or "textbelt" (free tier)
SMS_PROVIDER="stub"
SMS_TEXTBELT_KEY="textbelt"

# Admin back-office — comma-separated e-mails granted admin on login
ADMIN_EMAILS=""
