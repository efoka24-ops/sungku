DATABASE_URL="postgresql://user:password@host:5432/dbname"
PORT=4000

# Public base URL of this API (used to build the Camoo notification_url webhook)
APP_PUBLIC_URL="http://localhost:4000"

# Camoo Payment API — https://api.camoo.cm/v1/payment
# Leave CAMOO_API_KEY / CAMOO_API_SECRET blank in local dev to use the simulated
# confirmation fallback instead of calling the real payment provider.
CAMOO_BASE_URL="https://api.camoo.cm/v1/payment"
CAMOO_API_KEY=""
CAMOO_API_SECRET=""
CAMOO_CURRENCY="XAF"

# Auth / JWT
JWT_SECRET="change-me"
OTP_TTL_MINUTES="10"
# Fallback: expose the OTP code in the API response in production too (when e-mail
# delivery is unreliable). SECURITY RISK: anyone calling the API can read the code
# and log into any account. Use temporarily; set to "false" once e-mail works.
OTP_EXPOSE="false"

# SMTP (email OTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NoReply Sungku <noreply@example.com>"

# SMS provider — "stub" (log only) or "textbelt" (free tier)
SMS_PROVIDER="stub"
SMS_TEXTBELT_KEY="textbelt"

# Admin back-office — comma-separated e-mails granted admin on login
ADMIN_EMAILS=""

# Security
# Allowed browser origins for CORS (comma-separated). Server-to-server calls are always allowed.
CORS_ORIGINS="https://sungku-two.vercel.app,http://localhost:3000"
# Rate limits (per IP). Global = per minute; auth = per 15 minutes.
RATE_LIMIT_GLOBAL="600"
RATE_LIMIT_AUTH="30"

# ─── Passerelle de paiement apisungku ────────────────────────────────────────
# Prioritaire sur l'appel direct a PawaPay. Sungku ne detient alors aucun
# token operateur : la passerelle est seule a parler aux operateurs.
APISUNGKU_BASE_URL=https://apisungku.trugroup.cm/v1
# Fournis a l'enrolement du projet (POST /v1/projects), affiches une seule fois.
APISUNGKU_API_KEY=
APISUNGKU_WEBHOOK_SECRET=
