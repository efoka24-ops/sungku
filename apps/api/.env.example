DATABASE_URL="file:./dev.db"
PORT=4000

# Public base URL of this API (used to build the Camoo notification_url webhook)
APP_PUBLIC_URL="http://localhost:4000"

# Camoo Payment API — https://api.camoo.cm/v1/payment
# Leave CAMOO_API_KEY / CAMOO_API_SECRET blank in local dev to use the simulated
# confirmation fallback instead of calling the real payment provider.
CAMOO_BASE_URL="https://api.camoo.cm/v1/payment"
CAMOO_API_KEY=""
CAMOO_API_SECRET=""
CAMOO_CURRENCY="XAF"
